# ============================================================
# HelloAgents QA - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# --- LLM Configuration ---
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=60

# --- Search API (at least one for web search) ---
TAVILY_API_KEY=tvly-your-key-here
# SERPAPI_API_KEY=your-serpapi-key

# --- Knowledge Base ---
KNOWLEDGE_BASE_PATH=./data/knowledge_base
RAG_NAMESPACE=default
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_ENABLE_ADVANCED_SEARCH=true

# --- Memory System ---
MEMORY_USER_ID=qa_system
MEMORY_TYPES=working,episodic,semantic
MEMORY_WORKING_CAPACITY=100
MEMORY_WORKING_TTL_MINUTES=120

# --- Qdrant Vector Database (optional, uses local storage if empty) ---
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-key

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Agent Configuration ---
MAX_REACT_STEPS=5
MAX_REFLECTION_ITERATIONS=1
REFLECTION_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
